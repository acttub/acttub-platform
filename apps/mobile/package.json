{
  "name": "acting-app",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-document-picker"
        ]
      }
    }
  },
  "version": "0.0.1",
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "~1.13.7"
    },
    "@expo/plist@0.0.18": {
      "@xmldom/xmldom": "~0.8.15"
    }
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-exclude='app/**' --test-coverage-exclude='components/**' --test-coverage-exclude='hooks/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.mjs",
    "test:screens": "jest --coverage"
  },
  "dependencies": {
    "@bacons/apple-targets": "4.0.7",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^27.2.0",
    "@react-native-firebase/app": "^27.2.0",
    "@react-native-firebase/crashlytics": "^27.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-seoul/kakao-login": "^6.0.4",
    "airbridge-expo-sdk": "^4.10.0",
    "airbridge-react-native-sdk": "^4.10.0",
    "expo": "~58.1.0",
    "expo-apple-authentication": "~58.0.3",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-dev-client": "~58.0.22",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.15",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.19",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-media-library": "~58.0.14",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.6",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-speech": "~58.0.4",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-tracking-transparency": "~58.1.0",
    "expo-video": "~58.0.14",
    "expo-web-browser": "~58.1.0",
    "onnxruntime-react-native": "^1.24.3",
    "posthog-react-native": "4.77.1",
    "posthog-react-native-session-replay": "1.6.0",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-compressor": "^2.0.2",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "17.0.0",
    "react-native-purchases": "^10.15.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-share": "^12.3.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "patch-package": "^8.0.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "testTimeout": 15000,
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest-setup.ts"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "lib/**/*.tsx"
    ],
    "coverageReporters": [
      [
        "lcov",
        {
          "file": "jest.lcov.info"
        }
      ],
      "text-summary"
    ],
    "coverageDirectory": "coverage"
  }
}
