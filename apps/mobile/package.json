{
  "name": "acting-app",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-document-picker"
        ]
      }
    }
  },
  "version": "0.0.1",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-exclude='app/**' --test-coverage-exclude='components/**' --test-coverage-exclude='hooks/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.mjs",
    "test:screens": "jest --coverage"
  },
  "dependencies": {
    "@bacons/apple-targets": "4.0.7",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^25.1.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/crashlytics": "^25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-seoul/kakao-login": "^6.0.4",
    "airbridge-expo-sdk": "^4.10.0",
    "airbridge-react-native-sdk": "^4.10.0",
    "expo": "~56.0.24",
    "expo-apple-authentication": "~56.0.4",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.25",
    "expo-audio": "~56.0.13",
    "expo-build-properties": "~56.0.27",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.27",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "~56.0.28",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.13",
    "expo-image-picker": "~56.0.25",
    "expo-linking": "~56.0.19",
    "expo-localization": "~56.0.6",
    "expo-media-library": "~56.0.11",
    "expo-navigation-bar": "~56.0.3",
    "expo-network": "~56.0.5",
    "expo-notifications": "~56.0.26",
    "expo-router": "~56.2.22",
    "expo-secure-store": "~56.0.4",
    "expo-speech": "~56.0.3",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~56.0.16",
    "expo-status-bar": "~56.0.4",
    "expo-store-review": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-tracking-transparency": "~56.0.5",
    "expo-video": "~56.1.4",
    "expo-web-browser": "~56.0.6",
    "onnxruntime-react-native": "^1.24.3",
    "posthog-react-native": "4.77.1",
    "posthog-react-native-session-replay": "1.6.0",
    "pretendard": "^1.3.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-compressor": "^2.0.2",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-google-mobile-ads": "17.0.0",
    "react-native-purchases": "^10.15.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-share": "^12.3.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.6",
    "patch-package": "^8.0.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "setupFilesAfterEnv": [
      "<rootDir>/tests/jest-setup.ts"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "lib/**/*.tsx"
    ],
    "coverageReporters": [
      [
        "lcov",
        {
          "file": "jest.lcov.info"
        }
      ],
      "text-summary"
    ],
    "coverageDirectory": "coverage"
  }
}
