{
  "title": "첫 만남",
  "roles": [
    "지수",
    "민준"
  ],
  "lines": [
    {
      "kind": "dialogue",
      "role": "지수",
      "text": "오래 기다렸어? 진짜 오래."
    },
    {
      "kind": "dialogue",
      "role": "민준",
      "text": "(고개를 저으며) 아니, 나도 방금 왔어."
    },
    {
      "kind": "direction",
      "text": "암전"
    },
    {
      "kind": "dialogue",
      "role": "지수",
      "text": "다행이다."
    },
    {
      "kind": "dialogue",
      "role": "민준",
      "text": "응."
    }
  ]
}
