+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+/// AVAudioEngine 의 connect·installTap 은 입력 하드웨어 포맷이 어긋나면 Objective-C 예외(NSException)를 던진다.
+/// Swift do/catch 로는 못 잡아 앱이 꺼지므로 여기서 잡아 NSError 로 바꾼다(acttub SOMA-916).
+@interface ExpoSpeechObjCCatcher : NSObject
++ (BOOL)runBlock:(NS_NOESCAPE void (^)(void))block error:(NSError *_Nullable *_Nullable)error NS_SWIFT_NAME(run(_:));
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/node_modules/expo-speech-recognition/ios/ExpoSpeechObjCCatcher.m b/node_modules/expo-speech-recognition/ios/ExpoSpeechObjCCatcher.m
new file mode 100644
index 0000000..1075860
--- /dev/null
+++ b/node_modules/expo-speech-recognition/ios/ExpoSpeechObjCCatcher.m
@@ -0,0 +1,19 @@
+#import "ExpoSpeechObjCCatcher.h"
+
+@implementation ExpoSpeechObjCCatcher
+
++ (BOOL)runBlock:(NS_NOESCAPE void (^)(void))block error:(NSError *_Nullable *_Nullable)error {
+  @try {
+    block();
+    return YES;
+  } @catch (NSException *exception) {
+    if (error) {
+      *error = [NSError errorWithDomain:@"expo.modules.speechrecognition.objc"
+                                   code:1
+                               userInfo:@{NSLocalizedDescriptionKey : exception.reason ?: exception.name}];
+    }
+    return NO;
+  }
+}
+
+@end
