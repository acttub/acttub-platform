{
  "expo": {
    "name": "Acttub",
    "slug": "acting-app",
    "version": "0.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "actingapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.acttub.app",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "말한 내용을 글자로 바꾸기 위해 음성 인식 권한이 필요해요.",
        "NSMicrophoneUsageDescription": "음성으로 답변을 입력하려면 마이크 접근이 필요해요.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "연기 영상을 앱에서 바로 촬영하려면 카메라 접근이 필요해요."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0182F9",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.acttub.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "react-native-compressor",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "음성으로 답변을 입력하려면 마이크 접근이 필요해요.",
          "speechRecognitionPermission": "말한 내용을 글자로 바꾸기 위해 음성 인식 권한이 필요해요."
        }
      ],
      "expo-video",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.462651930952-ca5o968kkbucm1qg4ko1u6tepgv3beqf"
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-apple-authentication",
      "./plugins/with-rnfirebase-static.js",
      "./plugins/with-non-modular-headers.js",
      [
        "expo-camera",
        {
          "cameraPermission": "연기 영상을 앱에서 바로 촬영하려면 카메라 접근이 필요해요.",
          "microphonePermission": "촬영 영상에 소리를 담으려면 마이크 접근이 필요해요.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c0ea180-5d00-40a7-b109-9225f05fe291"
      }
    },
    "owner": "ryujisung"
  }
}
