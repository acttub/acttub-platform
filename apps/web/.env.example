# 브라우저 API 기준 URL입니다. FastAPI와 같은 오리진이면 빈 값으로 둡니다.
NEXT_PUBLIC_API_BASE_URL=

# 선택: Next.js 개발 서버가 /v2/*와 /health를 전달할 FastAPI 주소입니다.
DEV_API_ORIGIN=http://127.0.0.1:8000

# 로그인 공급자입니다. GIS 연동 전에는 dev를 사용합니다.
NEXT_PUBLIC_AUTH_PROVIDER=dev

# 1이면 실제 S3 PUT 대신 브라우저 목 업로더를 사용합니다.
NEXT_PUBLIC_MOCK_S3_UPLOAD=1
