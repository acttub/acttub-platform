# Supabase project configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_VIDEO_BUCKET=practice-videos

# Server-only acting-api gateway configuration.
ACTING_API_BASE_URL=http://127.0.0.1:8000
ACTING_API_KEY=your_acting_api_key

# Legacy Gemini compatibility only.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_QUESTION_MODEL=gemini-3-flash-preview

# Optional independent analysis worker tuning (defaults shown).
ANALYSIS_WORKER_CONCURRENCY=1
ANALYSIS_WORKER_LEASE_MS=120000
ANALYSIS_WORKER_HEARTBEAT_MS=30000
ANALYSIS_WORKER_POLL_MS=1000
ANALYSIS_WORKER_UPSTREAM_TIMEOUT_MS=900000
ANALYSIS_WORKER_SHUTDOWN_GRACE_MS=30000
