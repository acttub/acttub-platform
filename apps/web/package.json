{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-public-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "predev:lan": "node scripts/prepare-public-assets.mjs",
    "dev:lan": "next dev --hostname ${DEV_HOST:?맥의 LAN IP가 필요해요 (예: DEV_HOST=172.16.103.192)}",
    "prebuild": "node scripts/prepare-public-assets.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "generate:v2-schema": "openapi-typescript ../api/spec/openapi.json -o src/lib/api/v2-schema.d.ts",
    "perf": "lhci autorun --config=lighthouserc.cjs",
    "perf:healthcheck": "lhci healthcheck --fatal --config=lighthouserc.cjs"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.45.5",
    "@amplitude/plugin-session-replay-browser": "^1.33.7",
    "@mediabunny/aac-encoder": "^1.50.9",
    "@sentry/nextjs": "10.69.0",
    "fft.js": "^4.0.4",
    "hwp.js": "^0.0.3",
    "mammoth": "^1.12.1",
    "mediabunny": "^1.50.9",
    "next": "16.2.10",
    "onnxruntime-web": "^1.29.0",
    "pdfjs-dist": "^6.2.108",
    "pretendard": "1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
