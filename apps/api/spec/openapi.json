          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "email",
          "status"
        ],
        "title": "AuthUser"
      },
      "BiggestProblem": {
        "properties": {
          "start": {
            "type": "string",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "title": "End"
          },
          "dimension": {
            "type": "string",
            "title": "Dimension"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end",
          "dimension",
          "description"
        ],
        "title": "BiggestProblem"
      },
      "CoachReplyReq": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "text"
        ],
        "title": "CoachReplyReq"
      },
      "CoachStartReq": {
        "properties": {
          "summary_id": {
            "type": "string",
            "format": "uuid",
            "title": "Summary Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary_id"
        ],
        "title": "CoachStartReq"
      },
      "CoachTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "ai",
              "actor"
            ],
            "title": "Role"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "text"
        ],
        "title": "CoachTurn"
      },
      "CoachTurnResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "probe_intent",
              "dig_cause",
              "deflect",
              "close"
            ],
            "title": "Action"
          },
          "utterance": {
            "type": "string",
            "title": "Utterance"
          },
          "focus_timestamp": {
            "type": "string",
            "title": "Focus Timestamp"
          },
          "done": {
            "type": "boolean",
            "title": "Done"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "gap_stated",
                  "exhausted",
                  "limit",
                  "user_ended"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "action",
          "utterance",
          "focus_timestamp",
          "done",
          "reason"
        ],
        "title": "CoachTurnResponse"
      },
