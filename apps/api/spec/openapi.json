          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
