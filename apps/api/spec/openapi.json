          "evidence": {
            "type": "string",
            "title": "Evidence"
          },
          "self_discovery": {
            "type": "string",
            "title": "Self Discovery"
          },
          "encouragement": {
            "type": "string",
            "title": "Encouragement"
          },
          "next_step": {
            "type": "string",
            "title": "Next Step"
          },
          "comparison": {
            "type": "string",
            "title": "Comparison"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "headline",
          "biggest_problem",
          "evidence",
          "self_discovery",
          "encouragement",
          "next_step",
          "comparison"
        ],
        "title": "ActingReport"
      },
      "AuthUser": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
