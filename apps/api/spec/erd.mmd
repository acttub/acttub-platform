erDiagram
    users ||--o{ user_identities : "소셜 로그인 연결"
    users ||--o{ refresh_tokens : "기기별 토큰"
    users ||--o{ user_consents : "동의 주체"
    consent_documents ||--o{ user_consents : "동의 이벤트 로그"
    users ||--o{ upload_intents : "업로드 준비"
    users ||--o{ practice_sessions : "연습 세션 소유"
    upload_intents ||--|| practice_sessions : "인텐트 1건당 세션 1건"
    practice_sessions ||--o{ summaries : "재분석 시 1:N"
    summaries ||--o{ anomalies : "sort_order 순서 보존"
    summaries ||--o{ coach_sessions : "요약 1건으로 여러 코칭"
    coach_sessions ||--o{ coach_turns : "turn_index 순서 보장"
    coach_sessions ||--|| reports : "세션당 리포트 1건"
    practice_sessions ||--o{ external_operations : "AI 호출 멱등성"

    users {
        uuid id PK
        text email UK "NULL 허용 — 검증된 이메일만 저장"
        user_status_t status "active | suspended"
        timestamptz created_at
        timestamptz updated_at
    }
    user_identities {
        uuid id PK
        uuid user_id FK
        identity_provider_t provider "google | kakao | apple"
        text provider_uid "UNIQUE (provider, provider_uid)"
        timestamptz created_at
    }
    refresh_tokens {
        uuid id PK
        uuid user_id FK
        uuid replaced_by_id FK "self, NULL — 회전 연결"
        char64 token_hash UK "SHA-256, 평문 미저장"
        text device_info "NULL"
        timestamptz issued_at
        timestamptz expires_at
        timestamptz revoked_at "NULL"
    }
    consent_documents {
        uuid id PK
        consent_type_t type "terms | privacy | ai_analysis"
        text version "UNIQUE (type, version)"
        text title
        text body
        boolean required
        timestamptz published_at
    }
    user_consents {
        uuid id PK
        uuid user_id FK
        uuid document_id FK
        consent_action_t action "granted | declined | revoked"
        timestamptz occurred_at "INSERT only 이력"
    }
    upload_intents {
        uuid id PK
        uuid user_id FK
        upload_status_t status "pending | finalized | expired"
        text storage_provider "s3"
        text object_key UK
        text mime_type
        bigint size_bytes
        int duration_ms "NULL"
        text etag "NULL — finalize 시 기록, 내용 고정"
        timestamptz created_at
        timestamptz expires_at
        timestamptz finalized_at "NULL"
    }
    practice_sessions {
        uuid id PK
        uuid user_id FK
        uuid upload_intent_id FK, UK
        practice_status_t status "created | analyzing | analyzed | failed"
        text situation
        text character_context
        text subtext
        timestamptz hidden_at "NULL — 소프트 삭제"
        timestamptz created_at
        timestamptz updated_at
    }
    summaries {
        uuid id PK
        uuid session_id FK "ON DELETE CASCADE"
        jsonb observation
        text summary
        text intent_alignment
        text key_moment
        text key_dimension
        text model "분석에 쓴 Gemini 모델"
        boolean was_compressed
        jsonb raw "원본 보존 — 저장 후 불변"
        timestamptz created_at
    }
    anomalies {
        bigserial id PK
        uuid summary_id FK "ON DELETE CASCADE"
        int sort_order
        text start_ts "MM:SS 표기"
        text end_ts
        text dimension
        text what
        text why_odd
        text likely_cause
        text impact_on_intent
        boolean overlaps_key_moment
        boolean on_key_dimension
        intent_impact_t intent_impact "반전 | 약화 | 국소"
        severity_t severity "high | mid | low"
        text severity_reason
    }
    coach_sessions {
        uuid id PK
        uuid summary_id FK
        session_status_t status "open | closed"
        close_reason_t close_reason "NULL — gap_stated | exhausted | limit | user_ended"
        timestamptz created_at
        timestamptz updated_at
    }
    coach_turns {
        bigserial id PK
        uuid session_id FK "ON DELETE CASCADE"
        int turn_index "UNIQUE (session_id, turn_index)"
        turn_role_t role "ai | actor"
        text text
        text action "NULL — ai 턴만"
        text focus_timestamp
        timestamptz created_at
    }
    reports {
        uuid id PK
        uuid session_id FK, UK "세션당 리포트 1건"
        text headline
        jsonb biggest_problem
        text evidence
        text self_discovery
        text encouragement
        text next_step
        text comparison
        timestamptz created_at
    }
    external_operations {
        uuid id PK
        uuid session_id FK
        uuid user_id FK
        uuid request_id "UNIQUE (user_id, request_id)"
        operation_kind_t kind "analyze | coach_start | coach_reply | report"
        operation_status_t status "pending | running | succeeded | failed"
        int attempt_count "상한 3회"
        char64 request_fingerprint "kind + 본문 SHA-256"
        uuid lease_token "NULL"
        timestamptz lease_expires_at "NULL"
        text error_code "NULL"
        jsonb response_payload "NULL — 재응답 캐시"
        timestamptz created_at
        timestamptz updated_at
    }
