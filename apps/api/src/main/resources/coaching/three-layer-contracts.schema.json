                  "scene_context": {
                    "type": "object",
                    "properties": { "character_goal": { "$ref": "#/$defs/direction" } },
                    "required": ["character_goal"]
                  }
                },
                "required": ["focus", "scene_context"]
              }
            ],
            "properties": {
              "focus": {
                "$ref": "#/$defs/focus"
              },
              "practice": {
                "$ref": "#/$defs/practice"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "observation"
              }
            }
          },
          "then": {
            "properties": {
              "focus": {
                "$ref": "#/$defs/focus"
              },
              "practice": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "record_only"
              }
            }
          },
          "then": {
            "properties": {
              "focus": {
                "type": "null"
              },
              "reading": {
                "type": "null"
              },
              "practice": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
