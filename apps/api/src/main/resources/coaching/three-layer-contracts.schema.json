        "session_id",
        "source_handoff_revision",
        "record_ref",
        "lifecycle",
        "end_reason",
        "mode",
        "scene_context",
        "direction",
        "focus",
        "reading",
        "practice",
        "attempts",
        "open_points",
        "copy",
        "source_catalog"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "action"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "direction": { "$ref": "#/$defs/direction" }
