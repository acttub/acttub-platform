{
  "name": "acttub-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm dev:web",
    "build": "pnpm build:web",
    "lint": "pnpm lint:web",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "perf": "pnpm build:web && pnpm perf:web",
    "perf:web": "lhci autorun --config=apps/web/lighthouserc.cjs",
    "perf:healthcheck": "lhci healthcheck --fatal --config=apps/web/lighthouserc.cjs",
    "typecheck": "pnpm typecheck:web",
    "typecheck:web": "pnpm --filter web typecheck",
    "test:ai-pipeline-e2e-harness": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s scripts/ai_pipeline_e2e/tests -p 'test_*.py'",
    "preflight:ai-pipeline-e2e-harness": "pnpm test:ai-pipeline-e2e-harness && git diff --check"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1"
  }
}
