[Unit]
Description=acttub acting-api (Spring Boot, back svc)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
# 파이썬과 달리 인스턴스에서 의존성을 풀지 않는다. jar 하나가 전부다.
WorkingDirectory=/svc/acttub/api-java

# 힙 상한은 직접 준다 — 컨테이너가 아니라서 MaxRAMPercentage 는 호스트 전체를 보고
# 계산한다. api.env 에서 덮어쓸 수 있도록 EnvironmentFile 앞에 둔다.
Environment=JAVA_OPTS=-Xmx512m

# DATABASE_URL, JWT_SECRET, GEMINI_*, OPENAI_*, S3_*, AWS_*, ADMIN_OPS_TOKEN,
# SENTRY_DSN·SENTRY_ENVIRONMENT 등. DSN 이 없으면 Sentry 는 켜지지 않는다.
# 이름은 파이썬 시절 그대로다 — 이관하면서 바꾸지 않았다.
EnvironmentFile=/etc/acttub/api.env

# 포트는 api.env 가 덮지 못하게 EnvironmentFile 뒤에 둔다. application.yml 의
# server.port 기본값과 같은 값이라 로컬 bootRun 과 서버가 일치하고, 여기 명시해 두면
# 유닛이 포트를 고정한다는 의도가 드러난다.
Environment=SERVER_PORT=8080

# 🔁 **워커 스위치를 여기서 고정하지 않는다(SOMA-403 5단계).** 이관 기간에는
# `ANALYSIS_WORKER_ENABLED=false` 를 이 자리에 박아 두었다 — 두 백엔드가 같은
# external_operations 를 소비하면 파이썬 워커가 자바로 보낸 잡을 완료해버려 자바
# 파이프라인의 결함이 관찰 기간 내내 가려지기 때문이고, 그래서 큐 owner 를 파이썬
# 하나로 묶었다. **그 파이썬이 사라졌다.** 이제 소비자는 이 프로세스뿐이므로 그 줄을
# 지웠고, `AnalysisWorkerScheduler`·`MemoryWorkerScheduler` 의 `matchIfMissing = true`
# 가 켜진 상태를 기본으로 만든다.
#
# ⚠ **박아 둔 채로 파이썬만 지웠으면 신규 인스턴스가 조용히 깨진다** — 워커 없이 떠서
# 업로드가 영영 분석되지 않는데 /health 도 NRestarts 도 정상이라 배포는 초록이다.
# 사고 대응으로 워커만 끄고 싶으면 api.env 나 drop-in 으로 끈다.

ExecStart=/usr/bin/java $JAVA_OPTS -jar /svc/acttub/api-java/acting-api.jar
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
