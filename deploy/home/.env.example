# 홈서버 .env 견본 — /svc/acttub/<env>/.env 로 복사해 채운다(권한 600). 값은 저장소에 넣지 않는다.
# 여기 있는 키는 api·db·web·cloudflared·backup 이 쓰는 것이다(SOMA-489).
#
# 아래 필수 키(주석 처리되지 않은 것)가 하나라도 비면 compose 가 컨테이너를 만들기 전에 그 이름을 찍고 멈춘다.
# 예외는 COMPOSE_PROFILES 하나다(아래 설명).

# compose 프로젝트 이름. dev 는 acttub-dev, prod 는 acttub-prod. 볼륨은 <이름>_pgdata.
COMPOSE_PROJECT_NAME=
# 켤 프로필. edge = cloudflared(터널), backup = 매일 pg_dump(07). 서버는 둘 다 켠다. compose 가 이 파일에서
# 직접 읽는 값이라 deploy.sh 는 프로필을 모른다. 이 줄만은 비어도 멈추지 않는다 — 그냥 web·api·db 만 떠서
# 밖에서 안 닿는다. CI 스모크의 테스트용 .env 에는 일부러 이 줄이 없다.
COMPOSE_PROFILES=edge,backup

# ── Postgres (db 컨테이너) ─────────────────────────────────────────────────────
# DATABASE_URL 은 따로 적지 않는다 — compose 가 이 값으로 postgresql://<user>:<pw>@db:5432/<db> 를
# 조립해 api 에 넣는다. 비밀번호는 URL 에 그대로 들어가므로 영숫자만 쓴다: openssl rand -hex 24
POSTGRES_PASSWORD=
# 사용자·DB 이름은 비우면 acttub. 옮겨 오는 dev·운영 덤프의 소유자도 acttub 이다.
#POSTGRES_USER=acttub
#POSTGRES_DB=acttub

# ── API 필수 ───────────────────────────────────────────────────────────────────
JWT_SECRET=
# 탈퇴한 신원의 해시 키와 제공자 토큰 암호화 키(SOMA-528). 각각 openssl rand -hex 32.
# 한번 정하면 바꾸지 않는다 — 해시는 탈퇴 뒤 3년을 가고, 키가 바뀌면 보관 동의 철회의 본인 확인과
# 저장해 둔 애플·네이버 토큰의 복호화가 어긋난다. dev 와 prod 는 서로 다른 값을 쓴다.
ACCOUNT_IDENTITY_HASH_KEY=
ACCOUNT_TOKEN_ENCRYPTION_KEY=
# 웹의 공개 주소. 포트폴리오 공유 링크(<SITE_URL>/p/<slug>)를 만든다. 웹 빌드의 NEXT_PUBLIC_SITE_URL 과 같은 값:
# dev 는 https://dev.acttub.com, prod 는 https://acttub.com. 끝에 / 를 붙이지 않는다.
SITE_URL=
ADMIN_OPS_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
# 기능별 키. 기능마다 전용 키 또는 위 공용 키 중 하나는 있어야 한다(공용 키 없이 전용 키만 두어도 된다).
# 전용 키가 있으면 공용 키보다 먼저 쓰고, Gemini TTS·챌린지는 둘 다 없으면 기동이 멈춘다(코칭 키로 대신하지 않는다). 환경(dev·prod)은 같은 변수에 이 서버 .env 가 다른 값을 넣어 가른다.
# Gemini: COACH=직접 영상 코칭 A/B·관찰·영상 기록·음성 전사, TTS=리딩 음성, CHALLENGE=챌린지 비교.
#GEMINI_COACH_API_KEY=
#GEMINI_TTS_API_KEY=
#GEMINI_CHALLENGE_API_KEY=
# OpenAI: COACH=기존/비직접 코칭, SCRIPT_SPLIT=대본 분리, REPORT=코칭 노트·리포트, MEMORY=배우 기억.
#OPENAI_COACH_API_KEY=
#OPENAI_SCRIPT_SPLIT_API_KEY=
#OPENAI_REPORT_API_KEY=
#OPENAI_MEMORY_API_KEY=
# OpenRouter: 대본 나누기 줄 두 번째 의견(Jev). 비우면 그 단계를 건너뛴다. 모델은 SCRIPT_REVIEW_MODEL 로 바꾼다.
#OPENROUTER_SCRIPT_REVIEW_API_KEY=
#SCRIPT_REVIEW_MODEL=
# 영상 버킷. dev 는 acttub-practice-videos-dev, prod 는 -prod. 홈서버엔 인스턴스 role 이 없으니
# 버킷 하나만 허용하는 IAM 사용자(acttub-home-<env>)의 키를 둔다.
S3_BUCKET=
# 영상 버킷의 리전(둘 다 ap-northeast-2)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 리딩 기기 목소리 fp16 묶음(약 200MB)이 든 영상 버킷 안 위치(SOMA-747). 비우면 /v2/reading/voice-model 이 503 이고
# 앱은 조용히 원본 fp32(약 380MB)를 받는다 — 10/22 dev 에 빠져 있어 380MB 로 받던 일이 있었다. dev·prod 버킷 모두 같은 위치에 올려 두었다.
READING_VOICE_MODEL_PREFIX=reading-model/supertonic3-fp16-v1

# ── API 선택 ───────────────────────────────────────────────────────────────────
# DSN 이 비면 Sentry 는 꺼진다. SENTRY_RELEASE 는 release.env 가 준다.
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=dev
# dev 만 1. 오늘의 dev EC2 와 같다.
#DEVELOPMENT_AUTH_PROVIDER=1
#GEMINI_MODEL=gemini-2.5-flash
#OPENAI_CHAT_MODEL=
#OPENAI_TRANSCRIBE_MODEL=
#APPLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_ID=
# 로그인 제공자(SOMA-528). 켜 둔 제공자만 앱의 로그인 버튼으로 나간다. 기본은 google,apple.
# 카카오·네이버는 각 제공자의 검수 승인 뒤에만 운영에서 켠다.
#AUTH_ENABLED_PROVIDERS=google,apple
# 오디션 공고 모아보기(SOMA-564, app.audition). 켜면 API 가 공개 출처의 목록 페이지를 매일 07:00·19:00(KST)과 기동 2분
# 뒤(비었거나 12시간 넘게 못 모았을 때만) 읽는다. 꺼 두면 수집하지 않고 앱 목록은 비어 있다. 출처 등급은 ADR-034 —
# 경쟁 캐스팅 플랫폼 plfil 은 기본 목록에 없다.
#AUDITION_ENABLED=false
#AUDITION_SOURCES=shinsee,emk,sejong,otr
#AUDITION_COLLECT_CRON=0 0 7,19 * * *
# IP 제한(게스트 시작·공개 포트폴리오·로그인 등)이 방문자 주소를 구할 때 믿는 프록시의 CIDR 목록. 보통은
# 비워 둔다 — 비면 루프백과 사설 대역이다(web 컨테이너와 cloudflared 가 여기에 든다). Docker 네트워크를 사설
# 대역 밖으로 잡았을 때만 적는다. none 이면 전달 헤더를 아예 믿지 않는다.
#CLIENT_IP_TRUSTED_PROXIES=
# 애플 인가 코드 교환과 탈퇴 때의 토큰 폐기에 쓴다. 셋이 없으면 처음 온 애플 신원의 로그인이 503 이다
# (기존 애플 회원의 로그인은 된다). APPLE_PRIVATE_KEY 는 .p8 의 PEM 이고 줄바꿈은 \n 두 글자로 적어도 된다.
#APPLE_TEAM_ID=
#APPLE_KEY_ID=
#APPLE_PRIVATE_KEY=
# 카카오: 네이티브 앱 키(ID 토큰의 aud), 어드민 키(탈퇴 때 연결 끊기와 연결 해제 웹훅의 확인), 앱 ID(선택).
#KAKAO_OAUTH_CLIENT_ID=
#KAKAO_ADMIN_KEY=
#KAKAO_APP_ID=
# Airbridge: 앱이 귀속을 못 보낸 가입자의 설치 귀속을 서버가 다시 조회한다(SOMA-643). 토큰이 비면 꺼진다. 앱 이름 기본값은 acttub.
#AIRBRIDGE_API_TOKEN=
#AIRBRIDGE_APP_NAME=acttub
# 네이버: 앱이 넘긴 인가 코드를 서버가 교환한다. client secret 은 서버에만 둔다.
#NAVER_OAUTH_CLIENT_ID=
#NAVER_OAUTH_CLIENT_SECRET=
# 힙 비율 등 JVM 플래그를 바꿀 때만. 기본은 이미지의 -XX:MaxRAMPercentage=70.
#JAVA_TOOL_OPTIONS=

# ── 모니터링 선택 (SOMA-520) ────────────────────────────────────────────────
# 환경별로 다른 난수 토큰을 쓰며 모니터링 secrets/dev-token 또는 prod-token과 맞춘다.
# 비워도 일반 앱 배포는 성공하고 관리 포트 접근만 거부한다. 관리 포트 9091은 공개하지 않는다.
#MONITORING_TOKEN=
#MONITORING_ENVIRONMENT=dev

# ── web ────────────────────────────────────────────────────────────────────────
# 웹은 런타임 키가 없다 — 사이트 URL·Sentry·PostHog·API 주소는 이미지를 구울 때 굳는다
# (apps/web/Dockerfile 의 build-arg). 그래서 이미지가 환경별이다(release.env 의 WEB_IMAGE).

# ── cloudflared (edge 프로필) ───────────────────────────────────────────────────
# Cloudflare Zero Trust 에서 만든 터널(acttub-dev·acttub-prod)의 토큰. 호스트명 → http://web:3000 연결은
# 대시보드의 터널 설정에 있다. 토큰이 틀리면 cloudflared 가 healthy 가 되지 못해 deploy.sh 가 빨강이 된다.
# 프로필을 끄더라도 compose 는 파일 전체를 치환하므로 값이 비어 있으면 안 된다(edge 를 안 쓰면 아무 값이나).
TUNNEL_TOKEN=

# ── backup (backup 프로필) ─────────────────────────────────────────────────────
# 같은 IAM 키에 자기 환경 prefix의 PutObject/GetObject 권한이 있어야 한다.
# 버킷의 30일 수명주기 규칙은 AWS에서 관리한다. 컨테이너는 백업을 지우지 않는다.
BACKUP_S3_BUCKET=acttub-db-backups
BACKUP_S3_PREFIX=
# dev/ 또는 prod/를 정확히 적는다. 프로필이 켜진 채 비면 백업이 실패한다.
# 최초 기동은 즉시 백업하고 매일 한국시간 04:00에 실행한다. 놓친 실행은 재시작 때 보충한다.
#BACKUP_SCHEDULE=04:00
#BACKUP_MEM_LIMIT=256m

# ── 리소스 상한(비우면 dev 크기. SOMA-489 에서 정한 기본값) ─────────────────────
# prod: API_MEM_LIMIT=2g WEB_MEM_LIMIT=1g DB_MEM_LIMIT=1536m
#API_CPU_LIMIT=1.5
# CPU 몫(비율). dev 는 낮춰 운영이 먼저 쓰게 한다: dev API_CPU_SHARES=256 WEB_CPU_SHARES=256 PRON_CPU_SHARES=256
#API_CPU_SHARES=1024
#WEB_CPU_SHARES=1024
#PRON_CPU_SHARES=1024
#API_MEM_LIMIT=1536m
#WEB_MEM_LIMIT=512m
#DB_MEM_LIMIT=512m

# ── release.env (배포 스크립트가 쓴다 — 손으로 만들지 않는다) ─────────────────
# API_IMAGE=ghcr.io/acttub/acttub-platform/api:<sha>
# WEB_IMAGE=ghcr.io/acttub/acttub-platform/web:<env>-<sha>   환경별 이미지(dev-·prod-)
# BACKUP_IMAGE=ghcr.io/acttub/acttub-platform/backup:<sha>
# RENDER_GIT_COMMIT=<sha>     /health 의 commit 이 앞 7자를 낸다(HealthController)
# SENTRY_RELEASE=<sha>

# 관측(SOMA-517). 비워 두면 LLM 기록이 통째로 꺼진다 — 그 상태로도 서비스는 정상이다.
# 주소는 같은 호스트의 Langfuse 를 가리킨다(관측 스택이 루프백과 도커 게이트웨이에 함께 묶여 있다).
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── PG 심사 전용 테스트 빌링(SOMA-620, dev 전용) ───────────────────────────
# 기본은 꺼짐. 라이브 키·실제 구독 권한·자동 갱신은 지원하지 않는다.
# 운영 .env에는 추가하지 않는다. 개발자 체험 상점의 API 개별 연동 테스트 키만 쓴다.
#ACTTUB_PG_REVIEW_ENABLED=false
#ACTTUB_PG_REVIEW_ORIGIN=https://dev.acttub.com
#ACTTUB_PG_REVIEW_USERNAME=
# 비밀번호 원문 대신 무작위 전용 비밀번호의 SHA-256(hex 64자). 원문은 Vault에만 보관한다.
#ACTTUB_PG_REVIEW_PASSWORD_SHA256=
#ACTTUB_PG_REVIEW_TOSS_CLIENT_KEY=
#ACTTUB_PG_REVIEW_TOSS_SECRET_KEY=

# ── ACTTUB Pro 결제(SOMA-818) ─────────────────────────────────────────────
# 기본은 꺼짐. BILLING_WEB_ENABLED=true 일 때만 웹 토스 정기결제가 열린다(실결제). 키는 test_·live_ 둘 다 받되 두 키의 종류가 같아야 한다.
# 운영에 live 키를 넣는 것은 토스 카드사 심사 승인과 사용자 확인 뒤에만 한다. 값은 이 파일 밖(비밀 저장소)에서 가져온다.
# BILLING_PUBLIC_ORIGIN 은 토스가 브라우저를 되돌려 보낼 API 의 https 주소다(경로 없이).
# BILLING_WEB_RETURN_URL 은 카드 등록이 끝나면 돌아갈 웹 주소다(예: https://acttub.com/pricing/result).
# BILLING_APP_ENABLED 는 앱 Pro 화면·스토어 구독 검증을 여는 스위치다 — 토스를 열지 않는다.
#BILLING_WEB_ENABLED=false
#BILLING_APP_ENABLED=false
#BILLING_FREE_LIMITS_ENABLED=false
#BILLING_PUBLIC_ORIGIN=https://dev.acttub.com
#BILLING_WEB_RETURN_URL=
#BILLING_TOSS_CLIENT_KEY=
#BILLING_TOSS_SECRET_KEY=
# 앱 스토어 구독(SOMA-818 2단계, RevenueCat). 모두 기본 꺼짐이고 앱 화면은 BILLING_APP_ENABLED 가 따로 연다. 값은 비밀이므로 저장소에 넣지 않는다.
# BILLING_REVENUECAT_ENABLED=true 이고 REVENUECAT_SECRET_API_KEY(RevenueCat V1 비밀 키)가 있어야 동기화·웹훅이 RevenueCat 을 읽는다.
# 같은 조건에서 탈퇴하면 RevenueCat 고객도 지운다(DELETE /v1/subscribers/{회원 id}, 실패는 정리 장부가 7일까지 다시 시도).
# REVENUECAT_WEBHOOK_AUTH 는 RevenueCat 대시보드 웹훅의 Authorization 헤더 값 전체(예: "Bearer ...")다. 비어 있으면 웹훅을 모두 거부한다.
#   웹훅 URL: https://<API 주소>/v2/billing/store-notify/revenuecat
# REVENUECAT_ENTITLEMENT_ID 는 Pro 를 주는 entitlement(기본 pro).
# BILLING_REVENUECAT_ALLOW_SANDBOX 는 샌드박스(테스트) 구매로도 Pro 를 열지 정한다. 운영은 false, dev 만 true.
#BILLING_REVENUECAT_ENABLED=false
#REVENUECAT_SECRET_API_KEY=
#REVENUECAT_WEBHOOK_AUTH=
#REVENUECAT_ENTITLEMENT_ID=pro
#BILLING_REVENUECAT_ALLOW_SANDBOX=false
