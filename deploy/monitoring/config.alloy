// Template rendered by manage.py; @...@ is replaced with the selected environments and the Cloud Loki endpoint.
// Logs leave the home server, so drop noise and mask secrets here, before loki.write.
logging {
  level  = "warn"
  format = "logfmt"
}

discovery.docker "apps" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "apps" {
  targets = discovery.docker.apps.targets

@ENVIRONMENT_RULES@

  // Only selected app projects and their api/web/proxy services; db, backup, tunnel and other host containers are dropped.
  rule {
    source_labels = ["environment"]
    regex         = "dev|prod"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "api|web|proxy"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "apps" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.apps.output
  forward_to = [loki.process.apps.receiver]
}

loki.process "apps" {
  forward_to = [loki.write.cloud.receiver]

  // External uptime checks hit /health every minute; nginx /ping is already unlogged.
  // Plain nginx request line (before JSON logs), then nginx "path" / api "route" JSON fields.
  stage.drop {
    expression          = "\"(GET|HEAD) /(health|actuator)[/? ]"
    drop_counter_reason = "health"
  }
  stage.drop {
    expression          = "\"(path|route)\":\"/(health|actuator)[/\"]"
    drop_counter_reason = "health"
  }

  // Each capture group is replaced; key names stay in non-capturing groups. An empty replace omits the group.
  // Query strings carry search words and callback keys. JSON access lines have none; plain access lines
  // and nginx error lines (request/upstream/referrer) still do.
  stage.replace {
    expression = "\"(?:GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS) [^\"?\\s]*(\\?[^\"\\s]*)"
    replace    = ""
  }
  stage.replace {
    expression = "(?:upstream|referrer): \"[^\"?]*(\\?[^\"]*)\""
    replace    = ""
  }
  stage.replace {
    expression = "(?i)\\bbearer\\s+([A-Za-z0-9._~+/=-]+)"
    replace    = "[REDACTED]"
  }
  stage.replace {
    expression = "\\b(eyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]*)"
    replace    = "[REDACTED]"
  }
  stage.replace {
    expression = "(?i)[?&;](?:token|access_token|refresh_token|id_token|code|state|authkey|key|secret|password|signature|sig|x-amz-signature|x-amz-credential|x-amz-security-token)=([^&\\s\"']+)"
    replace    = "[REDACTED]"
  }
  stage.replace {
    expression = "(?i)\"(?:password|passwd|secret|token|access_token|refresh_token|id_token|authorization|cookie|api_key|apikey|authkey|client_secret)\"\\s*:\\s*\"([^\"]*)\""
    replace    = "[REDACTED]"
  }
  stage.replace {
    expression = "([A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,})"
    replace    = "[EMAIL]"
  }

  // Loki rejects oversized lines and a rejected batch is not retried.
  stage.truncate {
    rule {
      limit  = "64KiB"
      suffix = "...[TRUNCATED]"
    }
  }
}

loki.write "cloud" {
  endpoint {
    url = "@LOKI_URL@"
    basic_auth {
      username      = "@LOKI_USER@"
      password_file = "/etc/acttub/loki-token"
    }
  }
}
