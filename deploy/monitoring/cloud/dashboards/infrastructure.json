{
  "uid": "acttub-infrastructure",
  "title": "Acttub · 서버·DB·백업",
  "schemaVersion": 41,
  "version": 0,
  "editable": false,
  "tags": [
    "acttub-monitoring"
  ],
  "timezone": "Asia/Seoul",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "환경",
        "type": "custom",
        "query": "dev,prod",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "읽는 방법",
      "type": "text",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "환경과 기간은 상단에서 선택합니다. **수집 중**일 때 요청량 0은 요청 없음, p95의 **표본 없음**은 완료 표본 없음입니다. **수집 실패·수집 전**을 정상으로 해석하지 않습니다. 조회 Error는 PDC/데이터 소스 알림을 확인합니다. Sentry·Langfuse에서는 같은 환경과 기간을 선택합니다. 로컬 지표는 30일, Cloud 외부 점검은 14일 보관 기준입니다."
      }
    },
    {
      "id": 2,
      "title": "API 수집 상태",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 전·중단",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "수집 대상 없음·수집 전",
                  "color": "gray"
                },
                "0": {
                  "text": "수집 실패·갱신 중단",
                  "color": "red"
                },
                "1": {
                  "text": "수집 중",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${local_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(up{job=\"api\",environment=~\"$environment\"}) * (time()-max(timestamp(up{job=\"api\",environment=~\"$environment\"})) < bool 90)) or vector(-1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${local_uid}"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "마지막 API 수집 시각",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
