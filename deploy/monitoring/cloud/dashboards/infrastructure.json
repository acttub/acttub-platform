      "targets": [
        {
          "refId": "A",
          "expr": "max(timestamp(up{job=\"api\",environment=~\"$environment\"}))*1000",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${local_uid}"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "활성 알림",
      "type": "alertlist",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 30,
        "sortOrder": 1,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "error": true,
          "noData": true,
          "normal": false
        },
        "alertInstanceLabelFilter": "{owner=\"acttub-monitoring\"}",
        "dashboardAlerts": false
      }
    },
    {
      "id": 5,
      "title": "공유 호스트 CPU 사용률 (한 번만 집계)",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${local_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100*(1-avg(rate(node_cpu_seconds_total{environment=\"shared\",mode=\"idle\"}[5m])))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${local_uid}"
          }
        }
      ]
    },
