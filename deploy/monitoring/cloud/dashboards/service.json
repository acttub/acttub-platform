{
  "uid": "acttub-service",
  "title": "Acttub · 서비스 전체",
  "schemaVersion": 41,
  "version": 0,
  "editable": false,
  "tags": [
    "acttub-monitoring"
  ],
  "timezone": "Asia/Seoul",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "환경",
        "type": "custom",
        "query": "dev,prod",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "읽는 방법",
      "type": "text",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "환경과 기간은 상단에서 선택합니다. **수집 중**일 때 요청량 0은 요청 없음, p95의 **표본 없음**은 완료 표본 없음입니다. **수집 실패·수집 전**을 정상으로 해석하지 않습니다. 조회 Error는 PDC/데이터 소스 알림을 확인합니다. Sentry·Langfuse에서는 같은 환경과 기간을 선택합니다. 로컬 지표는 30일, Cloud 외부 점검은 14일 보관 기준입니다."
      }
    },
    {
      "id": 2,
      "title": "API 수집 상태",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 전·중단",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "수집 대상 없음·수집 전",
                  "color": "gray"
                },
                "0": {
                  "text": "수집 실패·갱신 중단",
                  "color": "red"
                },
                "1": {
                  "text": "수집 중",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${local_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(up{job=\"api\",environment=~\"$environment\"}) * (time()-max(timestamp(up{job=\"api\",environment=~\"$environment\"})) < bool 90)) or vector(-1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${local_uid}"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "마지막 API 수집 시각",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${local_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(timestamp(up{job=\"api\",environment=~\"$environment\"}))*1000",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${local_uid}"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "활성 알림",
      "type": "alertlist",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 30,
        "sortOrder": 1,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "error": true,
          "noData": true,
          "normal": false
        },
        "alertInstanceLabelFilter": "{owner=\"acttub-monitoring\"}",
        "dashboardAlerts": false
      }
    },
    {
      "id": 5,
      "title": "공개 health 상태",
      "type": "stat",
      "description": "외부 1개 위치, 60초 간격, HTTP 200과 정상 health JSON. DB·분석 성공 확인은 별도입니다.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 전·중단",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "실패",
                  "color": "red"
                },
                "1": {
                  "text": "정상",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${cloud_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=~\"acttub-health-$environment\"} and (time()-timestamp(probe_success{job=~\"acttub-health-$environment\"}) < 90)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${cloud_uid}"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "외부 점검 마지막 수집 시각",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${cloud_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(timestamp(probe_success{job=~\"acttub-health-$environment\"}))*1000",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${cloud_uid}"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "API 요청량 / 5분",
      "type": "timeseries",
      "description": "폴링·멱등 응답 재사용 포함. 0은 수집 정상일 때의 무사용입니다.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${local_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(increase(acttub_http_requests_total{environment=~\"$environment\"}[5m])))) and on() ((max(up{job=\"api\",environment=~\"$environment\"}) == 1) and on() (time()-max(timestamp(up{job=\"api\",environment=~\"$environment\"})) < 90))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${local_uid}"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "5xx 건수 / 5분",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${local_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(increase(acttub_http_requests_total{environment=~\"$environment\",status_class=\"5xx\"}[5m])))) and on() ((max(up{job=\"api\",environment=~\"$environment\"}) == 1) and on() (time()-max(timestamp(up{job=\"api\",environment=~\"$environment\"})) < 90))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${local_uid}"
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "5xx 비율 / 5분",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${local_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((100 * (sum(increase(acttub_http_requests_total{environment=~\"$environment\",status_class=\"5xx\"}[5m]))) / clamp_min((sum(increase(acttub_http_requests_total{environment=~\"$environment\"}[5m]))),1))) and on() ((max(up{job=\"api\",environment=~\"$environment\"}) == 1) and on() (time()-max(timestamp(up{job=\"api\",environment=~\"$environment\"})) < 90))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${local_uid}"
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "일반 API 평균 응답시간",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "수집 전·중단",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "표본 없음"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${local_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(http_server_requests_seconds_sum{environment=~\"$environment\",latency_class=\"ordinary\"}[5m])) / sum(rate(http_server_requests_seconds_count{environment=~\"$environment\",latency_class=\"ordinary\"}[5m]))) or ((0/0) * max(up{job=\"api\",environment=~\"$environment\"}))) and on() ((max(up{job=\"api\",environment=~\"$environment\"}) == 1) and on() (time()-max(timestamp(up{job=\"api\",environment=~\"$environment\"})) < 90))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${local_uid}"
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "일반 API p95 응답시간",
      "type": "timeseries",
      "description": "표본이 없으면 표본 없음. health·metrics·분석·코치·리포트 장시간 경로 제외. 알림에는 5분 20요청 조건을 적용합니다.",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "수집 전·중단",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "표본 없음"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${local_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((histogram_quantile(0.95, sum by(le)(rate(http_server_requests_seconds_bucket{environment=~\"$environment\",latency_class=\"ordinary\"}[5m])))) or ((0/0) * max(up{job=\"api\",environment=~\"$environment\"}))) and on() ((max(up{job=\"api\",environment=~\"$environment\"}) == 1) and on() (time()-max(timestamp(up{job=\"api\",environment=~\"$environment\"})) < 90))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${local_uid}"
          }
        }
      ]
    },
    {
      "id": 12,
      "title": "라우트별 요청량 / 5분",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${local_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(method,uri,status)(increase(http_server_requests_seconds_count{environment=~\"$environment\"}[5m]))) and on() ((max(up{job=\"api\",environment=~\"$environment\"}) == 1) and on() (time()-max(timestamp(up{job=\"api\",environment=~\"$environment\"})) < 90))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${local_uid}"
          }
        }
      ]
    }
  ]
}
