{
  "uid": "acttub-operations",
  "title": "Acttub · 분석·코치",
  "schemaVersion": 41,
  "version": 0,
  "editable": false,
  "tags": [
    "acttub-monitoring"
  ],
  "timezone": "Asia/Seoul",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "환경",
        "type": "custom",
        "query": "dev,prod",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "읽는 방법",
      "type": "text",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "환경과 기간은 상단에서 선택합니다. **수집 중**일 때 요청량 0은 요청 없음, p95의 **표본 없음**은 완료 표본 없음입니다. **수집 실패·수집 전**을 정상으로 해석하지 않습니다. 조회 Error는 PDC/데이터 소스 알림을 확인합니다. Sentry·Langfuse에서는 같은 환경과 기간을 선택합니다. External Operation 고유 접수는 멱등 응답 재사용을 제외하며 HTTP 요청량은 폴링·재사용을 포함합니다. 시도는 재시도를 포함합니다. 종료 사건은 고유 실행과 상호 배타적 합계가 아닙니다. 카운터 재시작·수집 공백 사이의 사건은 누락될 수 있습니다."
      }
    },
    {
      "id": 2,
      "title": "API 수집 상태",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 전·중단",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "수집 대상 없음·수집 전",
                  "color": "gray"
                },
                "0": {
                  "text": "수집 실패·갱신 중단",
                  "color": "red"
                },
                "1": {
                  "text": "수집 중",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${local_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(up{job=\"api\",environment=~\"$environment\"}) * (time()-max(timestamp(up{job=\"api\",environment=~\"$environment\"})) < bool 90)) or vector(-1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${local_uid}"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "마지막 API 수집 시각",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${local_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(timestamp(up{job=\"api\",environment=~\"$environment\"}))*1000",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${local_uid}"
