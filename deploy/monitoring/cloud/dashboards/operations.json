              "options": {
                "-1": {
                  "text": "수집 대상 없음·수집 전",
                  "color": "gray"
                },
                "0": {
                  "text": "수집 실패·갱신 중단",
                  "color": "red"
                },
                "1": {
                  "text": "수집 중",
                  "color": "green"
