    {
      "id": 6,
      "title": "새 고유 External Operation / 5분",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 전·중단",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${local_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(kind)(increase(acttub_external_operations_accepted_total{environment=~\"$environment\"}[5m]))) and on() ((max(up{job=\"api\",environment=~\"$environment\"}) == 1) and on() (time()-max(timestamp(up{job=\"api\",environment=~\"$environment\"})) < 90))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "datasource": {
